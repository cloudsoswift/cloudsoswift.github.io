&lt;tr&gt;
&lt;td&gt;deleted_date&lt;/td&gt;
&lt;td&gt;TIMESTAMP&lt;/td&gt;
&lt;td&gt;NULL&lt;/td&gt;
&lt;td&gt;삭제일시&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;perform_date&lt;/td&gt;
&lt;td&gt;TIMESTAMP&lt;/td&gt;
&lt;td&gt;NOT NULL&lt;/td&gt;
