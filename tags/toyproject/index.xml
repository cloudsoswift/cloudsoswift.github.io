&lt;td&gt;seq&lt;/td&gt;
&lt;td&gt;BIGSERIAL&lt;/td&gt;
&lt;td&gt;PK&lt;/td&gt;
&lt;td&gt;일련번호&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;performance_seq&lt;/td&gt;
